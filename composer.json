{
    "name": "card2k/card2k-php",
    "description": "SDK PHP chính thức cho API v3 của Card2K: nạp game, thẻ cào, đổi thẻ, ví, bảo hành, webhook. Có sẵn hỗ trợ Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "card2k",
        "api",
        "sdk",
        "laravel",
        "doi the",
        "the cao",
        "nap game"
    ],
    "homepage": "https://card2k.net/tai-lieu-api",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "guzzlehttp/psr7": "^2.0 || ^3.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "laravel/framework": "Hỗ trợ sẵn: client từ .env, Facade Card2K, Route::card2kWebhook() phát event Laravel."
    },
    "autoload": {
        "psr-4": {
            "Card2K\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Card2K\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@analyse",
            "@test"
        ],
        "check-spec": "php bin/check-spec.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Card2K\\Laravel\\Card2KServiceProvider"
            ],
            "aliases": {
                "Card2K": "Card2K\\Laravel\\Facades\\Card2K"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
