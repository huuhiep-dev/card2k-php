{
    "name": "card2k/card2k-php",
    "description": "SDK PHP chính thức cho API v3 của Card2K: nạp game, thẻ cào, đổi thẻ, ví, bảo hành, webhook.",
    "type": "library",
    "license": "MIT",
    "keywords": ["card2k", "api", "sdk", "doi the", "the cao", "nap game"],
    "homepage": "https://card2k.net/tai-lieu-api",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Thư viện HTTP (PSR-18) phổ biến nhất; SDK tự nhận nếu dự án đã có.",
        "symfony/http-client": "Thư viện HTTP (PSR-18) khác, cần kèm nyholm/psr7."
    },
    "autoload": {
        "psr-4": {
            "Card2K\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Card2K\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": ["@analyse", "@test"],
        "check-spec": "php bin/check-spec.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
